{
  "manifest_version": 3,
  "name": "Hivemind Assembly Connection Helper",
  "version": "1.0.0",
  "description": "Fills the ChatGPT and Claude connector forms for Hivemind Assembly, and the approval code on HA's approval page.",
  "key": "",
  "permissions": [
    "activeTab",
    "scripting",
    "nativeMessaging",
    "storage"
  ],
  "action": {
    "default_title": "Connect ChatGPT or Claude to Hivemind Assembly",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "optional_host_permissions": [
    "https://*.trycloudflare.com/*",
    "https://*.workers.dev/*"
  ]
}
